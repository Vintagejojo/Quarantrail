# Frontend (Vite) Node modules and build output
/frontend/node_modules/
/frontend/dist/

# Backend (Go) build output and dependencies
/backend/bin
/backend/pkg
/backend/vendor/

# Environment variables for both frontend and backend
/frontend/.env
/backend/.env
/frontend/.env.local
/backend/.env.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# VS Code settings
.vscode/

# Go modules
/backend/go.mod
/backend/go.sum

# Output of `go test` when running with coverage
/backend/coverage.out

# IDE files
.idea/

# Ignore binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Other OS-generated files
.DS_Store
Thumbs.db
